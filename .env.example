# Neon Postgres connection string (use the pooled connection string from the Neon console)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Better Auth
# Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL used by the client-side auth client
NEXT_PUBLIC_APP_URL="http://localhost:3000"
